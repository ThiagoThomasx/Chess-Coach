{
  "name": "chessquest",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.app.json --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:engine": "vitest run tests/engine-integration",
    "measure:pedagogy": "vitest run tests/measure --disableConsoleIntercept",
    "test:e2e": "playwright test",
    "postinstall": "node scripts/copy-engine.mjs",
    "coverage": "vitest run --coverage --coverage.include=src/services/** --coverage.include=src/db/** --coverage.reporter=text-summary"
  },
  "dependencies": {
    "chess.js": "^1.4.0",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "lucide-react": "^1.66.0",
    "react": "^19.3.1",
    "react-chessboard": "^5.12.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "recharts": "^3.10.1",
    "stockfish": "^19.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "fake-indexeddb": "^6.2.7",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
